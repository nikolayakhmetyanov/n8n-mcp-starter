# n8n API (for .cursor/mcp.json)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=replace-with-your-n8n-api-key

# n8n host/webhooks (for local bot development with ngrok)
# When ngrok URL changes (e.g. after restart), update WEBHOOK_URL in .env and restart containers.
WEBHOOK_URL=https://demo.ngrok-free.app

# Timezone
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow
